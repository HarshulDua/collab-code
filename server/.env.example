NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

MONGO_URI=mongodb://localhost:27017/collab
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Execution sandbox
SANDBOX_IMAGE=collab-sandbox:latest
EXEC_TIMEOUT_MS=8000
EXEC_MEMORY_BYTES=134217728
EXEC_MAX_OUTPUT_CHARS=20000
EXEC_MAX_CONCURRENT=4
EXEC_RATE_LIMIT_PER_MIN=10

# Google sign-in (optional — leave unset to disable the "Continue with Google"
# button). Create an OAuth 2.0 Web application client in the Google Cloud
# console, add your site to its Authorised JavaScript origins, and put the
# client ID here *and* in the client's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
